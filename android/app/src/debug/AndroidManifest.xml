<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <application>
    <service
      android:name=".DebugFakeCallConnectionService"
      android:exported="true"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService" />
      </intent-filter>
    </service>
    <receiver
      android:name=".DebugFakeIncomingCallReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="com.edgelink.app.DEBUG_FAKE_INCOMING_CALL" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".DebugSmsReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="com.edgelink.app.DEBUG_INJECT_SMS" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".DebugMiLinkProbeReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="com.edgelink.app.DEBUG_PROBE_MILINK" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
